# Database for saved call requests (Neon, set automatically by the Vercel integration). Empty = in-memory store (local dev only).
DATABASE_URL=

# Admin page (/admin). Set it yourself on Vercel: vercel env add ADMIN_PASSWORD production --sensitive
# Empty = the admin page says "Admin is not set up yet".
ADMIN_PASSWORD=

# Ogi, the chat assistant (lib/ogi/model.ts). With no GEMINI_API_KEY, the chat shows "Ogi is resting".
# The Gemini free tier is for demos only: Google may use free-tier requests to improve its products, and limits are small.
# Move to a paid tier before real visitors depend on Ogi.
BOT_MODEL_PROVIDER=
BOT_MODEL=
GEMINI_API_KEY=
